{
  "name": "glycines-jeu",
  "private": true,
  "version": "0.1.0",
  "description": "Une journée aux Glycines : jeu sérieux en 3D isométrique pour le CAP AAGA (Bloc 2)",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "valider": "tsx tools/valider-contenu.ts",
    "verifier": "pnpm typecheck && pnpm valider && pnpm test && pnpm build"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.2"
  },
  "packageManager": "pnpm@12.11.2"
}
